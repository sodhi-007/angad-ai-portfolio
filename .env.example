# ── AI chat (set OPENAI_API_KEY to enable LLM mode) ─────────────
# Without a key the chatbot falls back to local ranked retrieval.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Offline LLM-as-a-judge evals (scripts/judge.py) ────────────
# The OpenAI judge reuses OPENAI_API_KEY. Other providers use the API key
# environment variable expected by LiteLLM.
EVIDENTLY_JUDGE_PROVIDER=openai
EVIDENTLY_JUDGE_MODEL=gpt-4o-mini
EVIDENTLY_JUDGE_MIN_PASS_RATE=0.80
# Optional shared token for the hosted GitHub Actions benchmark. See README.
# RAG_EVAL_TOKEN=

# ── Owner portal ────────────────────────────────────────────────
# Required for remote/public access. Create a unique password.
ADMIN_PASSWORD=

# ── Durable storage (set on Render; leave empty for local dev) ──
# Knowledge library, portal edits, and the profile photo are stored in Turso,
# so they survive restarts. Without these, a local SQLite file is used.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Local development only (do NOT set on Render) ──────────────
HOST=127.0.0.1
PORT=4173

# ── Optional file paths (defaults are fine for most setups) ────
# PORTFOLIO_DATA_FILE=
# KNOWLEDGE_DB_FILE=
