# ── AI chat (set OPENAI_API_KEY to enable LLM mode) ─────────────
# Without a key the chatbot falls back to local ranked retrieval.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Owner portal ────────────────────────────────────────────────
# Required for remote/public access. Create a unique password.
ADMIN_PASSWORD=

# ── Local development only (do NOT set on Render) ──────────────
HOST=127.0.0.1
PORT=4173

# ── Optional file paths (defaults are fine for most setups) ────
# PORTFOLIO_DATA_FILE=
# KNOWLEDGE_DB_FILE=
